---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro'
import Footer from '../components/Footer.astro'
import searchIconUrl from '../../public/images/icons/search.png'

const searchQuery = Astro.url.searchParams.get('q') || "";

const githubHeaders: HeadersInit = {
  Accept: 'application/vnd.github.v3+json',
  ...(import.meta.env.TOKEN ? { Authorization: `Bearer ${import.meta.env.TOKEN}` } : {}),
};

function parseVersionTag(tag: string | null | undefined): string | null {
  if (!tag) return null;
  const match = tag.match(/^v?(\d+\.\d+(?:\.\d+)*(?:[.-][a-zA-Z0-9._-]*)?)/i);
  return match ? match[1] : null;
}

async function fetchLatestRelease(githubPage: string): Promise<string | null> {
  const match = githubPage.match(/github\.com\/([^\/]+)\/([^\/\?#]+)/);
  if (!match) return null;
  const owner = match[1];
  const repo = match[2].replace(/\.git$/, '');
  try {
    const res = await fetch(
      `https://api.github.com/repos/${owner}/${repo}/releases?per_page=1`,
      { headers: githubHeaders }
    );
    if (!res.ok) return null;
    const data = await res.json();
    if (!Array.isArray(data) || data.length === 0) return null;
    return parseVersionTag(data[0].tag_name);
  } catch {
    return null;
  }
}

//Get and sort all projects
const allProjects = await getCollection('projects');
const sortedProjects = allProjects
  .sort((a, b) => {
    const timeDiff = b.data.dateOfCreation.valueOf() - a.data.dateOfCreation.valueOf();
    if(timeDiff !== 0) return timeDiff;
    return a.data.title.localeCompare(b.data.title);
  });

const unsupportedProjects = sortedProjects.filter( p => p.data.supported === false).length;

// Fetch latest release tag for every project that has a githubPage, in parallel
const liveVersionEntries = await Promise.all(
  sortedProjects.map(async (p) => {
    if (!p.data.githubPage) return [p.id, null] as [string, null];
    const version = await fetchLatestRelease(p.data.githubPage);
    return [p.id, version] as [string, string | null];
  })
);
const liveVersionMap: Record<string, string | null> = Object.fromEntries(liveVersionEntries);

//Get and sort all tags
const allTags: string[] = [];
allProjects.forEach(p => {
	p.data.tags.forEach(t => {
		const upperTag = t.toUpperCase();
		if(!allTags.includes(upperTag))
			allTags.push(upperTag);
	})
});

const allTagsSorted = allTags
	.sort((a,b) => a.localeCompare(b));

//all projects sorted by tag
const projectsByTag: { key: string, value: typeof allProjects }[] = [];

allTagsSorted.forEach(t => {
	const projects = sortedProjects.filter(p => 
		p.data.tags.some(tag => tag.toUpperCase() === t)
	);
	projectsByTag.push({ key: t, value: projects });
});

// const query = Astro.url.searchParams.get('q'); 
// console.log(`Parameters: ${Astro.url.searchParams.get('q')}`);

---

<Layout title="library" currentTab="library">
	<div class="mx-4 sm:mx-10 lg:mx-20 mt-5">
		<div class="grid grid-rows-2 w-full mb-5 mt-2 items-center justify-center">
        	<div class='bg-white/5 backdrop-blur border border-white/20 border-t-steam-matrix/50 border-l-white/30 hover:scale-[1.02] transition-all duration-300 searchbar-visible rounded flex flex-row px-3 py-2 gap-3 shadow-[0_8px_32px_rgba(0,0,0,0.3),inset_0_1px_0_rgba(255,255,255,0.07)] z-1'>
        	    <input class="w-full bg-transparent text-steam-accent placeholder:text-slate-500 outline-none" id="search-input" placeholder="Search projects by name or tag...">
        	    <Image src={searchIconUrl} alt="Search" class="opacity-50"/>
        	</div>

			<span class="flex flex-row w-full z-2">
				<!-- Order by tag -->
				<input id="orderByTag" type="checkbox" class="w-5 h-5 accent-steam-blue cursor-pointer rounded mt-auto mb-auto ml-2"/>
				<h2 class="font-mono text-slate-400 uppercase mt-auto mb-auto ml-2">Order by tag</h2>
				<!-- Order by date -->
				<!-- <input id="orderByDate" type="checkbox" class="w-5 h-5 accent-steam-blue cursor-pointer rounded mt-auto mb-auto ml-2"/>
				<h2 class="font-mono text-slate-400 uppercase mt-auto mb-auto ml-2">Order by date</h2> -->
				<!-- Show archived/cancelled -->
				<input id="showUnsupported" type="checkbox" class="w-5 h-5 accent-steam-blue cursor-pointer rounded mt-auto mb-auto ml-10"/>
				<h2 class="font-mono text-slate-400 uppercase mt-auto mb-auto ml-2">Show archived (<span id="archived-count">{unsupportedProjects}</span>)</h2>
			</span>
		</div>

		<span id="ordered-project-list">
			{projectsByTag.map(group => (
    		<div>
    	    	<div class="tag-header mb-2">
					<h1 class="tag-title">{group.key}</h2>
				</div>
				<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 bg-steam-dark2/50 mb-5">
					{group.value
						.map(item => (
						<div
    	        		class="project-wrapper flex flex-col"
    	        		data-title={item.data.title.toLowerCase()}
    	        		data-tags={item.data.tags.join(' ').toLowerCase()}
						data-supported={String(item.data.supported)}>
							<ProjectCard project={item} liveVersion={liveVersionMap[item.id] ?? null}/>
						</div>
					))}
				</div>
    		</div>
			))}
		</span>

		<span id="unordered-project-list">
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">	
				{sortedProjects
				.map(item => (
					<div
    	    	    class="project-wrapper flex flex-col"
    	    	    data-title={item.data.title.toLowerCase()}
    	    	    data-tags={item.data.tags.join(' ').toLowerCase()}
					data-supported={String(item.data.supported)}>
						<ProjectCard project={item} liveVersion={liveVersionMap[item.id] ?? null}/>
					</div>
				))}
			</div>
		</span>
	</div>
</Layout>

<script type="application/json" id="gh-version-data" is:inline set:html={JSON.stringify(liveVersionMap)} />

<script>
  const VERSIONS_CACHE_KEY = 'gh-library-versions';

  const versionDataEl = document.getElementById('gh-version-data');
  const serverVersions: Record<string, string | null> = JSON.parse(versionDataEl?.textContent ?? '{}');

  // Persist every version the API returned successfully
  const toCache = Object.fromEntries(
    Object.entries(serverVersions).filter(([, v]) => v !== null)
  );
  if (Object.keys(toCache).length > 0) {
    try { localStorage.setItem(VERSIONS_CACHE_KEY, JSON.stringify(toCache)); } catch {}
  }

  // For projects where the API failed (null), restore from the last good cache
  const failedIds = Object.entries(serverVersions)
    .filter(([, v]) => v === null)
    .map(([id]) => id);

  if (failedIds.length > 0) {
    try {
      const cached: Record<string, string> = JSON.parse(
        localStorage.getItem(VERSIONS_CACHE_KEY) ?? '{}'
      );
      failedIds.forEach(id => {
        const cachedVersion = cached[id];
        if (cachedVersion) {
          document.querySelectorAll<HTMLElement>(`[data-version-id="${CSS.escape(id)}"]`)
            .forEach(el => { el.textContent = cachedVersion; });
        }
      });
    } catch {}
  }
</script>

<script>
	const input = document.querySelector('#search-input') as HTMLInputElement;
	const projectWrappers = document.querySelectorAll<HTMLElement>('.project-wrapper');
	const orderByTagCheck = document.querySelector('#orderByTag') as HTMLInputElement;
	const showUnsupported = document.querySelector('#showUnsupported') as HTMLInputElement;
	const archivedCountEl = document.querySelector('#archived-count');

	const query = new URLSearchParams(window.location.search).get('q');

	// Project lists
	const orderedList = document.querySelector('#ordered-project-list') as HTMLInputElement;
	const unorderedList = document.querySelector('#unordered-project-list') as HTMLInputElement;

	const updateShowInput = () => {
		const searchTerm = input.value.toLowerCase();
		const seen = new Set<string>();
		let archivedMatchCount = 0;

		projectWrappers.forEach(wrapper => {
			const title = wrapper.dataset.title || "";
			const tags = wrapper.dataset.tags || "";
			const show = showUnsupported?.checked;
			const isSupported = wrapper.dataset.supported === 'true';
			const matches = title.includes(searchTerm) || tags.includes(searchTerm);

			if (matches && (isSupported || show)) {
				wrapper.style.display = 'flex';
			} else {
				wrapper.style.display = 'none';
			}

			if (!isSupported && matches && !seen.has(title)) {
				seen.add(title);
				archivedMatchCount++;
			}
		});

		if (archivedCountEl) archivedCountEl.textContent = String(archivedMatchCount);

		// Hide tag group rows that have no visible projects
		orderedList.querySelectorAll<HTMLElement>(':scope > div').forEach(group => {
			const hasVisible = Array.from(group.querySelectorAll<HTMLElement>('.project-wrapper'))
				.some(w => w.style.display !== 'none');
			group.style.display = hasVisible ? 'block' : 'none';
		});
	}

	input?.addEventListener('input', updateShowInput);
	showUnsupported?.addEventListener('input', updateShowInput);

	const updateListDisplay = () => {
		if(orderByTagCheck?.checked){
			orderedList.style.display = 'block';
			unorderedList.style.display = 'none';
		} else {
			orderedList.style.display = 'none';
			unorderedList.style.display = 'block';
		}
	}

	orderByTagCheck?.addEventListener('change', updateListDisplay);
	
	if(query){
		input.value = query
	}
	
	updateListDisplay();
	updateShowInput();
</script>

<style is:global>
  @reference "../styles/global.css";
	.searchbar-visible{
        display: flex;
        width: 100%;
        justify-content: center;
        align-items: center;
        margin-right: auto;
    }

    .searchbar-hidden{
        display: none;
    }

	.tag-header{
		@apply border-b border-b-steam-accent/30 shadow-2xl;
	}

	.tag-title{
		@apply font-mono uppercase font-extrabold text-3xl;
	}
</style>