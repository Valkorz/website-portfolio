---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import TechTags from '../components/TechTags.astro'
import PictureSelf from '../../public/images/picture-self.jpeg'
import GraduationIcon from '../../public/images/icons/graduation.png'
import SuitcaseIcon from '../../public/images/icons/suitcase.png'
---

<Layout title="about" currentTab="about">
	<span>
		<div class="contentBox mt-5 w-[80%] p-4 shadow-2xl">
			<!-- <div class="flex items-center gap-3 mb-4">
  				<span class="px-2 py-1 bg-steam-blue/20 border border-steam-blue/50 text-steam-blue text-[10px] font-bold uppercase tracking-widest rounded-sm">
    				Leadership
  				</span>
  				<h2 class="text-white font-mono uppercase">Vice-Chairman @ MAIA AI Team</h2>
			</div> -->
			<!-- ABOUT ME -->
			<span class="lineBox">
				<div class="min-[500px]:flex min-[500px]:flex-row">
					<Image src={PictureSelf} alt="Me" class="h-32 w-32 rounded-full m-2"/>
					<span>
						<h1 class="title">ABOUT ME</h1>
						<p>
							Mechatronics Technician and Computer Engineering undergaduate. I love computers and everything related!
							From circuit design to software development, I've always been fascinated by the intricacies of the electronic world.
						</p>
						<p>
							I started my journey at 14 years old with my first Roblox game. After playing with Lua for a while, I took an introductory C#
							programming course available on FreeCodeCamp.org. I've been loving programming ever since, as I've engaged in several software projects
							ranging from applications, services to even games.
						</p>
					</span>
				</div>
			</span>
			<hr class="w-[80%] mt-5 h-5 mx-auto border-slate-700/65 bg-neutral-quaternary rounded-sm">
				
			<!-- WORK EXPERIENCE -->
			<span class="linebox">
				<h1 class="title flex flex-row text-start">
					<Image src={SuitcaseIcon} alt="work" class="w-12 h-12"/>
					<label class="mt-3 ml-2">WORK EXPERIENCE</label>
				</h1>
			</span>
			<span class="linebox">
				<!-- ── COMPANY: RAVEN TECNOLOGIA LTDA ── -->
				<div class="element-group">
					<div class="element-header">
						<span class="element-name">RAVEN TECNOLOGIA LTDA</span>
						<div class="element-line"></div>
					</div>

					<div class="relative pl-3 border-l-2 border-steam-blue/40 space-y-8">

						<!-- ROLE: Junior Software Developer -->
						<div class="role-entry group">
							<div class="role-dot group-hover:scale-125 transition-transform"></div>
							<div class="flex flex-col md:flex-row md:items-start justify-between gap-2 mb-1">
								<h3 class="text-lg font-black text-white uppercase tracking-tight leading-tight">Junior Software Developer</h3>
								<span class="text-steam-btn2 font-mono text-sm bg-steam-btn1/10 px-2 py-1 rounded">APR. 2026 — CURRENT</span>
							</div>
							<div class="text-slate-300 text-sm leading-relaxed mb-3 space-y-0.5">
								<p><b class="text-slate-200">Quality Assurance:</b> Routine QA tests on development branches to hunt for critical bugs.</p>
								<p><b class="text-slate-200">Feature Development:</b> Creation and maintenance of new features from user request.</p>
								<p><b class="text-slate-200">Code Review:</b> Code review of feature branches created by other co-developers.</p>
							</div>
							<div class="flex flex-wrap gap-2">
								<TechTags tags={["C#","Dotnet", "Entity Framework", "MVVM"]}/>
							</div>
						</div>

						<!-- ROLE: Software Development Intern -->
						<div class="role-entry group">
							<div class="role-dot group-hover:scale-125 transition-transform"></div>
							<div class="flex flex-col md:flex-row md:items-start justify-between gap-2 mb-1">
								<h3 class="text-lg font-black text-white uppercase tracking-tight leading-tight">Software Development Intern</h3>
								<span class="date-badge shrink-0">OCT. 2025 — APR. 2026</span>
							</div>
							<p class="text-slate-300 text-sm leading-relaxed mb-3">
								Contributing in the software maintenance and QA for the "Raven Scanner 3" vehicular device.
								Focused on optimizing the Bluetooth interfacing layer and MVVM architecture in Dotnet MAUI.
							</p>
							<div class="flex flex-wrap gap-2">
								<TechTags tags={["C#","Dotnet", "Entity Framework", "MVVM"]}/>
							</div>
						</div>

						<!-- ROLE: Firmware Development Intern -->
						<div class="role-entry group">
							<div class="role-dot role-dot--past group-hover:scale-125 transition-transform"></div>
							<div class="flex flex-col md:flex-row md:items-start justify-between gap-2 mb-1">
								<h3 class="text-lg font-black text-white uppercase tracking-tight leading-tight">Firmware Development Intern</h3>
								<span class="date-badge shrink-0">APR. 2025 — SEPT. 2025</span>
							</div>
							<p class="text-slate-300 text-sm leading-relaxed mb-3">
								Developing firmware for the ARM-Based "Raven Scanner 3" device. A scanner for vehicle diagnosis.
							</p>
							<div class="flex flex-wrap gap-2">
								<TechTags tags={["C/C++", "ARM"]}/>
							</div>
						</div>

					</div>
				</div>

				<!-- ── COMPANY: MAIA Intelligence & Automation ── -->
				<div class="element-group">
					<div class="element-header">
						<span class="element-name">MAIA Intelligence & Automation</span>
						<div class="element-line"></div>
					</div>

					<div class="relative pl-3 border-l-2 border-steam-blue/40 space-y-8">

						<!-- ROLE: Vice-Chairman -->
						<div class="role-entry group">
							<div class="role-dot group-hover:scale-125 transition-transform"></div>
							<div class="flex flex-col md:flex-row md:items-start justify-between gap-2 mb-1">
								<h3 class="text-lg font-black text-white uppercase tracking-tight leading-tight">Vice-Chairman</h3>
								<span class="date-badge shrink-0">MAR. 2025 — APR. 2026</span>
							</div>
							<div class="text-slate-300 text-sm leading-relaxed mb-3 space-y-0.5">
								<p><b class="text-slate-200">Strategic Oversight:</b> Co-lead a multidisciplinary team in the development of autonomous systems, reinforcement learning models, and computer vision projects.</p>
								<p><b class="text-slate-200">Technical Mentorship:</b> Oversee and manage the development of projects to ensure a streamlined and well-integrated workflow.</p>
								<p><b class="text-slate-200">Operations Management:</b> Plan and allocate workflow to meet project milestones and deadlines, using the SCRUM framework.</p>
							</div>
							<div class="flex flex-wrap gap-2">
								<TechTags tags={["Python","C/C++", "Computer Vision", "Artificial Intelligence", "OpenCV", "YOLO", "PyTorch"]}/>
							</div>
						</div>

						<!-- ROLE: Voluntary Intern -->
						<div class="role-entry group">
							<div class="role-dot role-dot--past group-hover:scale-125 transition-transform"></div>
							<div class="flex flex-col md:flex-row md:items-start justify-between gap-2 mb-1">
								<h3 class="text-lg font-black text-white uppercase tracking-tight leading-tight">Voluntary Intern</h3>
								<span class="date-badge shrink-0">MAR. 2024 — FEB. 2025</span>
							</div>
							<p class="text-slate-300 text-sm leading-relaxed mb-3">
								Aid in the development of Artificial Intelligence and Computer Vision based projects.
								Assistance in model training, data preparation, hardware/circuit development.
							</p>
							<div class="flex flex-wrap gap-2">
								<TechTags tags={["Python","C/C++", "Computer Vision", "Artificial Intelligence", "OpenCV", "YOLO", "PyTorch"]}/>
							</div>
						</div>

					</div>
				</div>
			</span>	

			<!-- EDUCATION -->
			<span class="linebox">
				<h1 class="title flex flex-row text-start">
					<Image src={GraduationIcon} alt="Education" class="w-12 h-12"/>
					<label class="mt-3 ml-2">EDUCATION</label>
				</h1>
			</span>
			<div class="element-group">
					<div class="element-header">
						<span class="element-name">Computer Engineering Undergraduate</span>
						<div class="element-line"></div>
					</div>

					<div class="relative pl-3 border-l-2 border-steam-blue/40 space-y-8">

						<!-- ROLE: Vice-Chairman -->
						<div class="role-entry group">
							<div class="role-dot group-hover:scale-125 transition-transform"></div>
							<div class="flex flex-col md:flex-row md:items-start justify-between gap-2 mb-1">
								<h3 class="text-lg font-black text-white uppercase tracking-tight leading-tight">Computer Engineering Bachelors</h3>
								<span class="text-steam-btn2 font-mono text-sm bg-steam-btn1/10 px-2 py-1 rounded">FEB. 2024 — DEC. 2028</span>
							</div>
							<div class="text-slate-300 text-sm leading-relaxed mb-3 space-y-0.5">
								Sorocaba Engineering School - UNIFACENS
							</div>
						</div>

						<!-- ROLE: Voluntary Intern -->
						<div class="role-entry group">
							<div class="role-dot role-dot--past group-hover:scale-125 transition-transform"></div>
							<div class="flex flex-col md:flex-row md:items-start justify-between gap-2 mb-1">
								<h3 class="text-lg font-black text-white uppercase tracking-tight leading-tight">Mechatronics Technician (Highschool Integrated)</h3>
								<span class="date-badge shrink-0">FEB. 2021 - DEC. 2023</span>
							</div>
							<p class="text-slate-300 text-sm leading-relaxed mb-3">
								ETEC Rubens de Faria e Souza / Centro Paula Souza
							</p>
						</div>

					</div>
				</div>
			</span>	
		</div>
	</span>
</Layout>

<style is:global>
  	@reference "../styles/global.css";

	.contentBox{
		@apply h-fit ml-auto mr-auto bg-steam-dark2/50 backdrop-blur rounded border border-white/30 border-t-steam-matrix/30;
	}

	.lineBox{
		@apply h-fit w-fit flex flex-row
	}

	.title{
		@apply uppercase font-extrabold text-2xl font-mono text-white
	}

	.caption{
		@apply uppercase font-bold text-slate-400;
	}

	/* Work experience grouping */
	.element-group {
		@apply mb-10;
	}

	.element-header {
		@apply flex items-center gap-3 mb-4;
	}

	.element-name {
		@apply text-steam-blue font-mono text-xs font-bold uppercase tracking-widest whitespace-nowrap;
	}

	.element-line {
		@apply flex-1 h-px bg-steam-blue/25;
	}

	.role-entry {
		@apply relative pb-2;
	}

	.role-dot {
		@apply absolute -left-[1.3rem] top-1 w-3.5 h-3.5 bg-steam-dark border-2 border-steam-blue rounded-full;
	}

	.role-dot--past {
		@apply border-steam-blue/40;
	}

	/* Date badges */
	.date-badge {
		@apply font-mono text-xs text-steam-blue bg-steam-blue/10 border border-steam-blue/25 px-2.5 py-1 rounded-sm tracking-wide;
	}

	.date-badge--current {
		@apply text-steam-matrix bg-steam-matrix/10 border-steam-matrix/35;
	}
</style>
