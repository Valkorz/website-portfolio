---
import { Image } from 'astro:assets'
const base = import.meta.env.BASE_URL;
const { project, liveVersion } = Astro.props;
const displayVersion: string = liveVersion ?? project.data.version ?? '1.0.0';
const { dateOfCreation } = project.data;
const slug = project.id.replace(/\.md$/, '');

//actually the biggest bullshit I've ever seen
const cleanBase = base.endsWith('/') ? base : `${base}/`;
const projectLink = `${cleanBase}projects/${slug}`;

const getOrdinal = (n: number) => {
  const s = ["th", "st", "nd", "rd"];
  const v = n % 100;
  return n + (s[(v - 20) % 10] || s[v] || s[0]);
};

const formattedDate = dateOfCreation.toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
});

const day = getOrdinal(dateOfCreation.getDate());
const dateString = `${formattedDate.split(' ')[0]} ${day}, ${dateOfCreation.getFullYear()}`;
---

<a  href={projectLink}
    class="group h-full transition-all duration-300 rounded">
    <div class="relative h-full flex flex-col group-hover:scale-[1.02] backdrop-blur rounded border border-white/20 border-t-steam-matrix/50 border-l-white/30 transition-all duration-300 shadow-[0_8px_32px_rgba(0,0,0,0.3),inset_0_1px_0_rgba(255,255,255,0.07)] group-hover:shadow-[0_8px_32px_rgba(0,170,255,0.1),inset_0_0_30px_rgba(102,192,244,0.08),inset_0_1px_0_rgba(255,255,255,0.12)]">

        {!project.data.supported && (
            <div class="archived-title-visible">
                <h3 class="text-yellow-400/70 inset-shadow-sm font-bold font-mono">ARCHIVE</h3>
            </div>
        )}

        <div class="relative aspect-video grow overflow-hidden rounded-t bg-steam-dark2">
            <Image
            src={project.data.thumbnail}
            alt={project.data.title}
            class="absolute inset-0 block w-full h-full object-cover"
            />
        </div>

        <div class="p-4 border-b-2 border-transparent group-hover:border-steam-blue bg-linear-to-b from-steam-dark to-steam-dark2 overflow-hidden rounded-b flex flex-col gap-1.5 shrink-0">
            <h3 class="text-white truncate font-bold font-mono text-lg uppercase tracking-tight">{project.data.title}</h3>
            <span class="flex flex-wrap gap-1.5">
                {
                    project.data.tags
                        .sort((a : string, b : string) => a.localeCompare(b))
                        .slice(0, 4)
                        .map((tag: string) => (
                        <span class="text-[10px] truncate h-5 overflow-hidden bg-black/40 px-2 py-0.5 text-steam-accent">
                            {tag}
                        </span>
                    ))
                }
            </span>
            <p class="text-slate-400/70 text-xs leading-snug line-clamp-2 min-h-[2lh] mt-0.5">{project.data.description}</p>
            <div class="flex items-center justify-between mt-auto pt-1">
                <span class="text-slate-500 text-xs">{dateString}</span>
                <span
                    class="font-mono text-[10px] font-bold px-1.5 py-0.5 bg-steam-blue/10 border border-steam-blue/25 text-steam-blue/70"
                    data-version-id={project.id}
                >
                    {displayVersion}
                </span>
            </div>
        </div>

    </div>
</a>

<style is:global>
  @reference "../styles/global.css";
    .perspective-1000{
        perspective: 1000px;
    }

    .archived-title-visible{
        @apply z-10 flex align-middle rounded-2xl items-center justify-center absolute w-25 right-0 p-3 m-3 border-2 border-yellow-400/70 bg-steam-dark2/80;
    }
</style>